+// TEMP PERF INSTRUMENTATION (env-gated via FOUNDRY_PERF). Applied from
+// misc/foundry_perf/headless_scan_harness.patch to measure the watcher headless. Not committed.
+static bool _efs_perf() {
+	static int c = -1;
+	if (c == -1) {
+		c = (OS::get_singleton() && OS::get_singleton()->has_environment("FOUNDRY_PERF")) ? 1 : 0;
+	}
+	return c == 1;
+}
+static int _efs_perf_scan_remaining = -1;
+static void _efs_perf_advance(EditorFileSystem *p_efs) {
+	if (_efs_perf_scan_remaining <= 0) {
+		return;
+	}
+	_efs_perf_scan_remaining--;
+	if (_efs_perf_scan_remaining > 0) {
+		if (OS::get_singleton()->has_environment("FOUNDRY_PERF_TOUCH")) {
+			const String tmp = "res://.__perf_touch_tmp";
+			{
+				Ref<FileAccess> f = FileAccess::open(tmp, FileAccess::WRITE);
+				if (f.is_valid()) {
+					f->store_8(0);
+				}
+			}
+			DirAccess::remove_absolute(tmp);
+			const int delay_usec = OS::get_singleton()->has_environment("FOUNDRY_PERF_TOUCH_DELAY_USEC") ?
+					OS::get_singleton()->get_environment("FOUNDRY_PERF_TOUCH_DELAY_USEC").to_int() :
+					50000;
+			if (delay_usec > 0) {
+				OS::get_singleton()->delay_usec(delay_usec);
+			}
+		}
+		p_efs->call_deferred("scan_sources");
+		p_efs->set_process(true);
+	} else if (p_efs->get_tree()) {
+		print_line("[PERF][scan_changes] harness done, quitting");
+		p_efs->get_tree()->quit();
+	}
+}
