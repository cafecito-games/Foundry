<?xml version="1.0" encoding="utf-8"?>
<resources>
	<style name="FoundryEditorTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
	</style>

	<style name="FoundryGameTheme" parent="FoundryEditorTheme">
		<item name="android:windowIsTranslucent">true</item>
	</style>

	<style name="FoundryEditorSplashScreenTheme" parent="Theme.SplashScreen.IconBackground">
		<!-- Set the theme of the Activity that directly follows your splash
		screen. This is required. -->
		<item name="postSplashScreenTheme">@style/FoundryEditorTheme</item>
	</style>

	<style name="FoundryEmbeddedGameTheme" parent="@android:style/Theme.DeviceDefault.Panel">
	</style>
</resources>
