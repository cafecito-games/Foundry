#include "core/version.h"

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

FOUNDRY_ICON ICON platform/windows/godot.ico
1 RT_MANIFEST "platform/windows/godot.manifest"

1 VERSIONINFO
FILEVERSION     FOUNDRY_VERSION_MAJOR,FOUNDRY_VERSION_MINOR,FOUNDRY_VERSION_PATCH,0
PRODUCTVERSION  FOUNDRY_VERSION_MAJOR,FOUNDRY_VERSION_MINOR,FOUNDRY_VERSION_PATCH,0
FILEOS          4
FILETYPE        1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",            "Foundry"
            VALUE "FileDescription",        FOUNDRY_VERSION_NAME
            VALUE "FileVersion",            FOUNDRY_VERSION_NUMBER
            VALUE "ProductName",            FOUNDRY_VERSION_NAME
            VALUE "Licence",                "MIT"
            VALUE "LegalCopyright",         "(c) 2007-present Juan Linietsky, Ariel Manzur and Godot Engine contributors"
            VALUE "Info",                   "https://godotengine.org"
            VALUE "ProductVersion",         FOUNDRY_VERSION_FULL_BUILD
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
