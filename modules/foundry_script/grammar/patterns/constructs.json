{
  "$comment": "Declaration-name, call, type-position, and contextual-keyword rules. Every rule here is anchored by a lookbehind on an already-consumed reserved word or by the start of a line, so contextual keywords stay ordinary identifiers everywhere else. Reserved words themselves are never scoped here: they carry the scope the tokenizer-derived keyword rules give them.",
  "declaration-names": {
    "patterns": [
      {
        "match": "(?<=\\bclass_name|\\btrait_name|\\benum_name|\\btuple_name|\\bnamespace|\\bimport|\\bextends|\\buses|\\bclass|\\btrait|\\benum|\\btuple)\\s+([\\p{L}_][\\p{L}\\p{N}_]*(?:\\.[\\p{L}_][\\p{L}\\p{N}_]*)*)",
        "captures": {
          "1": {
            "name": "entity.name.type.foundryscript"
          }
        }
      },
      {
        "match": "(?<=\\bfunc)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
        "captures": {
          "1": {
            "name": "entity.name.function.foundryscript"
          }
        }
      },
      {
        "match": "(?<=\\bsignal)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
        "captures": {
          "1": {
            "name": "entity.name.function.signal.foundryscript"
          }
        }
      },
      {
        "match": "(?<=\\bvar|\\bconst)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
        "captures": {
          "1": {
            "name": "variable.other.declaration.foundryscript"
          }
        }
      }
    ]
  },
  "contextual-keywords": {
    "patterns": [
      {
        "match": "^\\s*(annotation)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
        "captures": {
          "1": {
            "name": "storage.type.annotation.foundryscript"
          },
          "2": {
            "name": "entity.name.type.annotation.foundryscript"
          }
        }
      },
      {
        "match": "^\\s*(extend)\\s+([\\p{L}_][\\p{L}\\p{N}_]*(?:\\.[\\p{L}_][\\p{L}\\p{N}_]*)*)",
        "captures": {
          "1": {
            "name": "storage.modifier.extend.foundryscript"
          },
          "2": {
            "name": "entity.name.type.foundryscript"
          }
        }
      },
      {
        "match": "\\b(async)(?=\\s+(?:static\\s+|final\\s+|abstract\\s+)*func\\b)",
        "captures": {
          "1": {
            "name": "storage.modifier.async.foundryscript"
          }
        }
      },
      {
        "match": "(?<=\\))\\s+(targets)\\b",
        "captures": {
          "1": {
            "name": "keyword.other.targets.foundryscript"
          }
        }
      },
      {
        "match": "^\\s*(get)\\b(?=\\s*[:=])",
        "captures": {
          "1": {
            "name": "storage.type.accessor.foundryscript"
          }
        }
      },
      {
        "match": "^\\s*(set)\\b(?=\\s*(?:[:=]|\\([^)]*\\)\\s*:))",
        "captures": {
          "1": {
            "name": "storage.type.accessor.foundryscript"
          }
        }
      }
    ]
  },
  "calls": {
    "match": "\\b([\\p{L}_][\\p{L}\\p{N}_]*)(?=\\s*\\()",
    "captures": {
      "1": {
        "name": "entity.name.function.call.foundryscript"
      }
    }
  },
  "type-positions": {
    "match": "(?<=->|:)\\s*(\\p{Lu}[\\p{L}\\p{N}_]*(?:\\.[\\p{L}_][\\p{L}\\p{N}_]*)*)",
    "captures": {
      "1": {
        "name": "entity.name.type.foundryscript"
      }
    }
  }
}
