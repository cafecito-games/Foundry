#!/usr/bin/env python
import glob
import os

from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_foundry_script = env_modules.Clone()

frontend_sources = {
    "fs_tokenizer.cpp",
    "fs_tokenizer_buffer.cpp",
    "fs_parser.cpp",
    "fs_analyzer.cpp",
    "fs_compiler.cpp",
    "fs_byte_codegen.cpp",
    "fs_warning.cpp",
    "fs_format.cpp",
}

if not env["foundry_script_frontend"]:
    if env.editor_build:
        print(
            "Error: foundry_script_frontend=no is not supported for editor builds. "
            "The editor requires the Foundry Script front-end."
        )
        Exit(255)
    if env["tests"]:
        print(
            "Error: foundry_script_frontend=no is incompatible with tests=yes. "
            "Foundry Script unit tests require the front-end (dev_mode=yes also implies tests=yes)."
        )
        Exit(255)
    if env.get("use_fuzzer", False):
        print(
            "Error: foundry_script_frontend=no is incompatible with use_fuzzer=yes. "
            "The Foundry Script fuzz harness requires the front-end."
        )
        Exit(255)

    module_dir = env_foundry_script.Dir("#modules/foundry_script").abspath
    sources = [
        os.path.basename(path)
        for path in glob.glob(os.path.join(module_dir, "*.cpp"))
        if os.path.basename(path) not in frontend_sources
    ]
    env_foundry_script.add_source_files(env.modules_sources, sources)
    # Using a define in the disabled case, to avoid having an extra define
    # in regular builds where the front-end is enabled.
    env_foundry_script.Append(CPPDEFINES=["FOUNDRY_SCRIPT_NO_FRONTEND"])
else:
    env_foundry_script.add_source_files(env.modules_sources, "*.cpp")

if env.editor_build:
    env_foundry_script.add_source_files(env.modules_sources, "./editor/*.cpp")

    SConscript("editor/script_templates/SCsub")

    # Those two modules are required for the language server protocol
    if env["module_jsonrpc_enabled"] and env["module_websocket_enabled"]:
        env_foundry_script.add_source_files(env.modules_sources, "./language_server/*.cpp")
    else:
        # Using a define in the disabled case, to avoid having an extra define
        # in regular builds where all modules are enabled.
        env_foundry_script.Append(CPPDEFINES=["FOUNDRY_SCRIPT_NO_LSP"])
        # Also needed in main env to unexpose --lsp-port option.
        env.Append(CPPDEFINES=["FOUNDRY_SCRIPT_NO_LSP"])


if env["tests"]:
    env_foundry_script.Append(CPPDEFINES=["TESTS_ENABLED"])
    env_foundry_script.add_source_files(env.modules_sources, "./tests/*.cpp")

# Platform-independent libFuzzer harness (parser/analyzer). Compiled only for
# fuzzing builds; the platform-specific entry point lives under platform/.
if env.get("use_fuzzer", False):
    env_foundry_script.add_source_files(env.modules_sources, "./tests/fuzz/*.cpp")
