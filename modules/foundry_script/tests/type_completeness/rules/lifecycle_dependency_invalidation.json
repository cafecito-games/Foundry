  "exceptions": [
    {
      "id": "a_loaded_binary_does_not_follow_its_dependency_on_stale",
      "parent": "clean_to_stale",
      "when": {
        "surface": "bytecode"
      },
      "derive": {
        "semantic_identity": "same",
        "transition_outcome": "same"
      },
      "rationale": "A compiled binary carries the dependency's type inside it and an already loaded one is never re-read, so nothing that happens to the file the dependency lives in reaches this artifact: the dependent's view of the carried type is the one the binary was built with whether that file was revised, retired, or damaged.",
      "positive_witnesses": [
