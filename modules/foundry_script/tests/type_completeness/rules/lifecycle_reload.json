{
  "schema_version": 2,
  "family": "lifecycle_reload",
  "adapter": "lifecycle",
  "domain": {
    "destination": [
      "plain",
      "union",
      "optional",
      "container_element",
      "tuple_field"
    ],
    "lifecycle_state": [
      "clean",
      "incremental",
      "stale",
      "missing",
      "reordered",
      "failure_recovery"
    ],
    "surface": [
      "text",
      "bytecode"
    ]
  },
  "required_dimensions": [
    {
      "dimension": "semantic_identity",
      "when": {}
    },
    {
      "dimension": "transition_outcome",
      "when": {}
    }
  ],
  "anchors": [
    {
      "id": "plain_clean",
      "coordinates": {
        "destination": "plain",
        "lifecycle_state": "clean"
      },
      "expect": {
        "semantic_identity": "preserved",
        "transition_outcome": "completed"
      },
      "surfaces": [
        "text",
        "bytecode"
      ]
    },
    {
      "id": "union_clean",
      "coordinates": {
        "destination": "union",
        "lifecycle_state": "clean"
      },
      "expect": {
        "semantic_identity": "preserved",
        "transition_outcome": "completed"
      },
      "surfaces": [
        "text",
        "bytecode"
      ]
    },
    {
      "id": "optional_clean",
      "coordinates": {
        "destination": "optional",
        "lifecycle_state": "clean"
      },
      "expect": {
        "semantic_identity": "preserved",
        "transition_outcome": "completed"
      },
      "surfaces": [
        "text",
        "bytecode"
      ]
    },
    {
      "id": "container_element_clean",
      "coordinates": {
        "destination": "container_element",
        "lifecycle_state": "clean"
      },
      "expect": {
        "semantic_identity": "preserved",
        "transition_outcome": "completed"
      },
      "surfaces": [
        "text",
        "bytecode"
      ]
    },
    {
      "id": "tuple_field_clean",
      "coordinates": {
        "destination": "tuple_field",
        "lifecycle_state": "clean"
      },
      "expect": {
        "semantic_identity": "preserved",
        "transition_outcome": "completed"
      },
      "surfaces": [
        "text",
        "bytecode"
      ]
    }
  ],
  "relations": [
    {
      "id": "clean_to_incremental",
      "from": {
        "lifecycle_state": "clean"
      },
      "to": {
        "lifecycle_state": "incremental"
      },
      "derive": {
        "semantic_identity": "same",
        "transition_outcome": "same"
      }
    },
    {
      "id": "clean_to_stale",
      "from": {
        "lifecycle_state": "clean"
      },
      "to": {
        "lifecycle_state": "stale"
      },
      "derive": {
        "semantic_identity": "projected",
        "transition_outcome": "same"
      }
    },
    {
      "id": "clean_to_missing",
      "from": {
        "lifecycle_state": "clean"
      },
      "to": {
        "lifecycle_state": "missing"
      },
      "derive": {
        "semantic_identity": "rejected",
        "transition_outcome": "refused"
      }
    },
    {
      "id": "clean_to_reordered",
      "from": {
        "lifecycle_state": "clean"
      },
      "to": {
        "lifecycle_state": "reordered"
      },
      "derive": {
        "semantic_identity": "same",
        "transition_outcome": "same"
      }
    },
    {
      "id": "clean_to_failure_recovery",
      "from": {
        "lifecycle_state": "clean"
      },
      "to": {
        "lifecycle_state": "failure_recovery"
      },
      "derive": {
        "semantic_identity": "same",
        "transition_outcome": "recovered"
      }
    }
  ],
  "exceptions": [
    {
      "id": "a_loaded_binary_is_not_re_read_on_stale",
      "parent": "clean_to_stale",
      "when": {
        "surface": "bytecode"
      },
      "derive": {
        "semantic_identity": "same",
        "transition_outcome": "same"
      },
      "rationale": "A compiled binary that is already loaded is never re-read: FoundryScript::reload links an invalid one and leaves a valid one exactly as it is, because an exported binary is immutable and there is nothing newer to pick up. Reloading the identity therefore carries the type the binary was built with rather than the one the artifact behind it now holds, and a damaged artifact reads the same as a healthy one because neither is read at all.",
      "positive_witnesses": [
        {
          "id": "bytecode_plain_stale",
          "coordinates": {
            "destination": "plain",
            "lifecycle_state": "stale",
            "surface": "bytecode"
          }
        },
        {
          "id": "bytecode_union_stale",
          "coordinates": {
            "destination": "union",
            "lifecycle_state": "stale",
            "surface": "bytecode"
          }
        }
      ],
      "boundary_witnesses": [
        {
          "id": "text_plain_stale_boundary",
          "coordinates": {
            "destination": "plain",
            "lifecycle_state": "stale",
            "surface": "text"
          }
        }
      ]
    },
    {
      "id": "a_loaded_binary_is_not_re_read_on_failure_recovery",
      "parent": "clean_to_failure_recovery",
      "when": {
        "surface": "bytecode"
      },
      "derive": {
        "semantic_identity": "same",
        "transition_outcome": "indistinguishable"
      },
      "rationale": "A compiled binary that is already loaded is never re-read: FoundryScript::reload links an invalid one and leaves a valid one exactly as it is, because an exported binary is immutable and there is nothing newer to pick up. Reloading the identity therefore carries the type the binary was built with rather than the one the artifact behind it now holds, and a damaged artifact reads the same as a healthy one because neither is read at all.",
      "positive_witnesses": [
        {
          "id": "bytecode_plain_failure_recovery",
          "coordinates": {
            "destination": "plain",
            "lifecycle_state": "failure_recovery",
            "surface": "bytecode"
          }
        },
        {
          "id": "bytecode_union_failure_recovery",
          "coordinates": {
            "destination": "union",
            "lifecycle_state": "failure_recovery",
            "surface": "bytecode"
          }
        }
      ],
      "boundary_witnesses": [
        {
          "id": "text_plain_failure_recovery_boundary",
          "coordinates": {
            "destination": "plain",
            "lifecycle_state": "failure_recovery",
            "surface": "text"
          }
        }
      ]
    }
  ],
  "max_chain_length": 3
}
