{
  "schema_version": 1,
  "adapter": "destination_wrapper",
  "dimensions": [
    {
      "id": "analysis",
      "outcomes": [
        "accept",
        "reject"
      ]
    },
    {
      "id": "runtime_obligation",
      "outcomes": [
        "typed_destination_check",
        "union_membership_check"
      ]
    },
    {
      "id": "stored_carrier",
      "outcomes": [
        "plain_destination",
        "admitting_alternative",
        "optional_payload",
        "element_slot",
        "reified_argument",
        "tuple_slot",
        "callable_slot",
        "nominal_instance",
        "trait_witness"
      ]
    },
    {
      "id": "diagnostic_severity",
      "outcomes": [
        "none",
        "warning",
        "error"
      ]
    }
  ]
}
