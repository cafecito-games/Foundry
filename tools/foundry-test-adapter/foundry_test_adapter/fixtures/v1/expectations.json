  "run": [
    {
      "name": "no selection runs every discovered leaf",
      "discovery": "run/discovery.jsonl",
      "report": "run/report_all.tap",
      "select": [],
      "expected_leaves": ["S1::a", "S1::b", "S2::c"],
      "violations": []
    },
    {
      "name": "selecting a suite includes its descendants",
      "discovery": "run/discovery.jsonl",
      "report": "run/report_suite_selection.tap",
      "select": ["S1"],
      "expected_leaves": ["S1::a", "S1::b"],
      "violations": []
    },
    {
      "name": "repeated and overlapping selections deduplicate",
      "discovery": "run/discovery.jsonl",
      "report": "run/report_suite_selection.tap",
      "select": ["S1", "S1", "S1::a"],
      "expected_leaves": ["S1::a", "S1::b"],
      "violations": []
    },
    {
      "name": "an unknown selected identifier is a protocol error",
      "discovery": "run/discovery.jsonl",
      "report": "run/report_empty.tap",
      "select": ["S3"],
      "expected_leaves": [],
      "violations": [
        { "code": "unknown_selection_id", "location": "" }
      ]
    },
    {
      "name": "points must follow deterministic discovery order",
      "discovery": "run/discovery.jsonl",
      "report": "run/report_out_of_order.tap",
      "select": [],
      "expected_leaves": ["S1::a", "S1::b", "S2::c"],
      "violations": [
        { "code": "result_order_mismatch", "location": "" }
      ]
    },
    {
      "name": "a report must answer exactly the selection",
      "discovery": "run/discovery.jsonl",
      "report": "run/report_unselected.tap",
      "select": ["S1"],
      "expected_leaves": ["S1::a", "S1::b"],
      "violations": [
        { "code": "unexpected_result_id", "location": "" },
        { "code": "missing_result_id", "location": "" }
      ]
    }
  ]
