{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:foundry:test-adapter:v1:capabilities",
  "title": "Foundry Test Adapter capabilities document",
  "type": "object",
  "required": ["protocol", "supported_versions", "framework", "extensions"],
  "properties": {
    "protocol": {
      "const": "foundry-test-adapter"
    },
    "supported_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "framework": {
      "type": "object",
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/framework_string" },
        "name": { "$ref": "#/$defs/framework_string" },
        "version": { "$ref": "#/$defs/framework_string" }
      }
    },
    "extensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      }
    }
  },
  "$defs": {
    "framework_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    }
  }
}
